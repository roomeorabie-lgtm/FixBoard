rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Phone directory lookup: stores phone number uniqueness and password hash
    match /phone_directory/{phoneNumber} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Brands (Samsung, Apple, Xiaomi, Huawei, etc.)
    match /brands/{brandId} {
      allow read: if true;
      allow write: if true;
    }

    // Series (Galaxy S, iPhone, Redmi, etc.)
    match /series/{seriesId} {
      allow read: if true;
      allow write: if true;
    }

    // Models
    match /models/{modelId} {
      allow read: if true;
      allow write: if true;
    }

    // Motherboards
    match /boards/{boardId} {
      allow read: if true;
      allow write: if true;
    }

    // Components on motherboards
    match /boardComponents/{compDocId} {
      allow read: if true;
      allow write: if true;
    }

    // Electrical Net traces
    match /boardNets/{netDocId} {
      allow read: if true;
      allow write: if true;
    }

    // Schematics documents
    match /schematics/{schematicId} {
      allow read: if true;
      allow write: if true;
    }

    // User Favorites & History
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    match /history/{historyId} {
      allow read, write: if true;
    }
  }
}
